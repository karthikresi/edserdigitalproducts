{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile in EDSER store",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID matching auth.uid",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Display name of customer",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL",
          "maxLength": 512
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string or server timestamp",
          "maxLength": 64
        },
        "wishlist": {
          "type": "array",
          "description": "Array of saved product IDs in the user wishlist"
        },
        "wishlistPreferences": {
          "type": "object",
          "description": "User preferences for wishlist notifications and priority"
        }
      },
      "required": ["userId", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase record for instant digital downloads",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique Order ID (e.g. EDS-123456)",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "User UID who made the purchase",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "customerEmail": {
          "type": "string",
          "description": "Delivery email for download access",
          "maxLength": 256
        },
        "customerName": {
          "type": "string",
          "description": "Customer display name",
          "maxLength": 128
        },
        "total": {
          "type": "number",
          "description": "Total purchase amount in USD"
        },
        "downloadAccessCode": {
          "type": "string",
          "description": "Secret access code for lifetime downloads",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Real-time order fulfillment status",
          "enum": ["Processing", "Delivered"],
          "maxLength": 32
        },
        "itemIds": {
          "type": "array",
          "description": "List of purchased digital product IDs"
        },
        "createdAt": {
          "type": "string",
          "description": "Order creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["orderId", "userId", "customerEmail", "total", "downloadAccessCode"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "User saved template or wishlist item",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "savedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "productId"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer ratings and feedback reviews on digital products",
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 128
        },
        "userPhotoURL": {
          "type": "string",
          "maxLength": 512
        },
        "rating": {
          "type": "integer",
          "description": "Rating score from 1 to 5 stars"
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "comment": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["reviewId", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer user profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Digital purchase and download access records"
    },
    "/users/{userId}/saved/{productId}": {
      "schema": "SavedItem",
      "description": "User bookmarked or wishlisted digital templates"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": "ProductReview",
      "description": "Public customer feedback and star ratings on products"
    }
  }
}
